<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.kepco.pms.main.sample.mapper.SampleMapper">

    <!-- sample list -->
    <select id="selectSampleList" resultType="resultMap" parameterType="sampleVO">
        /* kr.co.kepco.pms.main.sample.mapper.SampleMapper.selectSampleList */
        SELECT seq
             , title
             , contents
          FROM tb_sample
         WHERE 1=1
    </select>
</mapper>